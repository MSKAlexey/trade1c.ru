&После("ЗаполнитьДанныеУПД_5_02_ИнформацияПродавца")
Процедура АЭР_ЗаполнитьДанныеУПД_5_02_ИнформацияПродавцаПосле(Знач Основание, Знач Настройки, Данные, Описание, Отказ)
	
	Если Не Отказ Тогда
		АЭР_ДобавитьДанныеУПДЭТМ(Основание, Данные);
	КонецЕсли;
	
КонецПроцедуры

&После("ЗаполнитьДанныеУПД_5_03_ИнформацияПродавца")
Процедура АЭР_ЗаполнитьДанныеУПД_5_03_ИнформацияПродавцаПосле(Знач Основание, Знач Настройки, Данные, Описание, Отказ)
	
	Если Не Отказ Тогда
		АЭР_ДобавитьДанныеУПДЭТМ(Основание, Данные);
	КонецЕсли;
	
КонецПроцедуры

Процедура АЭР_ДобавитьДанныеУПДЭТМ(Основание, Данные)
	
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Реализация = АЭР_ПолучитьРеализацию(Основание);
	Если Не ЗначениеЗаполнено(Реализация) Тогда
		Возврат;
	КонецЕсли;
	
	Если АЭР_ИННОрганизации(Реализация) <> "5024136666" Тогда
		Возврат;
	КонецЕсли;
	
	ЗаказКлиента = АЭР_ПолучитьЗаказКлиента(Реализация);
	НомерЗаказаЭТМ = АЭР_ПолучитьНомерЗаказаЭТМ(ЗаказКлиента);
	
	Если Не АЭР_ЭтоДокументЭТМ(Реализация, НомерЗаказаЭТМ) Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеДанныеШапки = Новый Структура;
	ДополнительныеДанныеШапки.Вставить("ИдГрузПолуч", "4660011515045");
	ЭлектронноеВзаимодействие.ДобавитьДопДанныеВДерево(
		Данные,
		ДополнительныеДанныеШапки,
		Истина);
	
	Если ПустаяСтрока(НомерЗаказаЭТМ) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаТоваров = Данные.Строки.Найти(
		"ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях",
		"ПолныйПуть",
		Истина);
	
	Если ТаблицаТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеДанныеСтроки = Новый Структура;
	ДополнительныеДанныеСтроки.Вставить("ЗаказНомер", НомерЗаказаЭТМ);
	
	Для Каждого СтрокаТовара Из ТаблицаТоваров.Строки Цикл
		ЭлектронноеВзаимодействие.ДобавитьДопДанныеВДерево(
			СтрокаТовара,
			ДополнительныеДанныеСтроки,
			Истина);
	КонецЦикла;
	
КонецПроцедуры

Функция АЭР_ПолучитьРеализацию(Основание)
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Возврат Основание;
	КонецЕсли;
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ДокументОснование = АЭР_ЗначениеРеквизита(Основание, "ДокументОснование");
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			Возврат ДокументОснование;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Документы.РеализацияТоваровУслуг.ПустаяСсылка();
	
КонецФункции

Функция АЭР_ПолучитьЗаказКлиента(Реализация)
	
	ЗаказКлиента = АЭР_ЗначениеРеквизита(Реализация, "ЗаказКлиента");
	Если ТипЗнч(ЗаказКлиента) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		Возврат ЗаказКлиента;
	КонецЕсли;
	
	Попытка
		ОбъектРеализации = Реализация.ПолучитьОбъект();
		Для Каждого СтрокаТовара Из ОбъектРеализации.Товары Цикл
			Попытка
				ЗаказКлиента = СтрокаТовара.ЗаказКлиента;
			Исключение
				ЗаказКлиента = Неопределено;
			КонецПопытки;
			Если ТипЗнч(ЗаказКлиента) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
				Возврат ЗаказКлиента;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ОбъектРеализации = Неопределено;
	КонецПопытки;
	
	Возврат Документы.ЗаказКлиента.ПустаяСсылка();
	
КонецФункции

Функция АЭР_ПолучитьНомерЗаказаЭТМ(ЗаказКлиента)
	
	Если Не ЗначениеЗаполнено(ЗаказКлиента) Тогда
		Возврат "";
	КонецЕсли;
	
	НомерПоДаннымКлиента = АЭР_Строка(АЭР_ЗначениеРеквизита(ЗаказКлиента, "НомерПоДаннымКлиента"));
	Если Не ПустаяСтрока(НомерПоДаннымКлиента) Тогда
		Возврат НомерПоДаннымКлиента;
	КонецЕсли;
	
	Возврат АЭР_Строка(АЭР_ЗначениеРеквизита(ЗаказКлиента, "Номер"));
	
КонецФункции

Функция АЭР_ИННОрганизации(Реализация)
	
	Организация = АЭР_ЗначениеРеквизита(Реализация, "Организация");
	ИНН = АЭР_Строка(АЭР_ЗначениеРеквизита(Организация, "ИНН"));
	ИНН = СтрЗаменить(ИНН, " ", "");
	ИНН = СтрЗаменить(ИНН, "-", "");
	Возврат ИНН;
	
КонецФункции

Функция АЭР_ЭтоДокументЭТМ(Реализация, НомерЗаказаЭТМ)
	
	НаименованиеКонтрагента = АЭР_НаименованиеУчастника(
		АЭР_ЗначениеРеквизита(Реализация, "Контрагент"));
	НаименованиеПартнера = АЭР_НаименованиеУчастника(
		АЭР_ЗначениеРеквизита(Реализация, "Партнер"));
	
	НаименованиеУчастников = ВРег(НаименованиеКонтрагента + " " + НаименованиеПартнера);
	Если СтрНайти(НаименованиеУчастников, "ЭТМ") > 0
		ИЛИ СтрНайти(НаименованиеУчастников, "ЭЛЕКТРОТЕХМОНТАЖ") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	НомерЗаказаВерхнийРегистр = ВРег(НомерЗаказаЭТМ);
	Возврат Лев(НомерЗаказаВерхнийРегистр, 3) = "1L."
		ИЛИ СтрНайти(НомерЗаказаВерхнийРегистр, ".ETA.") > 0;
	
КонецФункции

Функция АЭР_НаименованиеУчастника(Участник)
	
	Если Не ЗначениеЗаполнено(Участник) Тогда
		Возврат "";
	КонецЕсли;
	
	НаименованиеПолное = АЭР_Строка(АЭР_ЗначениеРеквизита(Участник, "НаименованиеПолное"));
	Если Не ПустаяСтрока(НаименованиеПолное) Тогда
		Возврат НаименованиеПолное;
	КонецЕсли;
	
	Возврат АЭР_Строка(АЭР_ЗначениеРеквизита(Участник, "Наименование"));
	
КонецФункции

Функция АЭР_ЗначениеРеквизита(Объект, ИмяРеквизита)
	
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект, ИмяРеквизита);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция АЭР_Строка(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции
